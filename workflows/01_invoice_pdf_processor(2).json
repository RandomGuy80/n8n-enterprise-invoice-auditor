    {
      "parameters": {
        "jsCode": "const rawOutput = $input.first().json.output || '{}';\nconst pdfText = $('Extract from File').first().json.text || '';\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nlet parsed = {};\ntry {\n  const cleaned = rawOutput.replace(/```json|```/gi, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Ошибка парсинга JSON от AI-аудитора: ' + rawOutput.slice(0, 150));\n}\n\nconst inputTokens = Math.ceil((pdfText.length + 1200) / 3);\nconst outputTokens = Math.ceil(rawOutput.length / 3);\nconst totalTokens = inputTokens + outputTokens;\nconst estimatedCostUsd = Number(((inputTokens * 0.00000014) + (outputTokens * 0.00000028)).toFixed(6));\n\nconst requiresHuman = Boolean(parsed.requires_human_approval);\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    invoice_number: String(parsed.invoice_number || 'Б/Н'),\n    vendor_name: String(parsed.vendor_name || 'Неизвестный поставщик'),\n    total_amount: Number(parsed.total_amount || 0),\n    currency: String(parsed.currency || 'RUB'),\n    line_items: parsed.line_items || [],\n    audit_status: String(parsed.audit_status || 'passed'),\n    requires_human_approval: requiresHuman,\n    approval_status: requiresHuman ? 'pending' : 'auto_approved',\n    audit_notes: String(parsed.audit_notes || 'Проверка завершена'),\n    llm_tokens_used: totalTokens,\n    estimated_cost_usd: estimatedCostUsd\n  }\n}];\n"
      },
